# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email is handled via Supabase Edge Functions + Resend
# No client-side email config needed — all env vars are set in Supabase dashboard:
#   RESEND_API_KEY     — Get from resend.com/api-keys
#   SENDER_EMAIL       — Verified sender email (e.g., noreply@casa-lis.com)
#   SENDER_NAME        — Sender display name (e.g., Casa Lis)
